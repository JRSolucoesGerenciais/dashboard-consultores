# Supabase (Postgres). Settings > Database > Connection string.
# Aplicação e rotina diária: "Transaction pooler" (porta 6543). Funciona em IPv4 (GitHub Actions).
#   postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Só para `pnpm db:migrate`: "Session pooler" (porta 5432 do mesmo host). Opcional; se vazio usa DATABASE_URL.
MIGRATE_DATABASE_URL=

# Desenvolvimento/testes sem servidor: DATABASE_URL=pglite://./.data/dev  (Postgres embutido)

# Segredo da sessão (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=

# Token da API CSAgenda (nunca versionar o valor real)
ORACLE_API_TOKEN=

# Proteção opcional da rota de importação externa
PROJECT_IMPORT_API_KEY=

# Somente para criar o primeiro administrador: pnpm admin:create
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Armazenamento de anexos dos check-ins (serviço Manus; vazio = anexos desativados)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

NODE_ENV=development
